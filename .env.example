# ----------------------------------------------------------------------------
# DATABASE (SQL Server)
# ----------------------------------------------------------------------------
# Local development — Windows Authentication (integrated security), connects
# as whichever Windows account is running the Node process. Requires
# TCP/IP enabled on your SQL Server instance (SQL Server Configuration
# Manager -> SQL Server Network Configuration -> Protocols).
#
# Default (unnamed) local instance:
DATABASE_URL="sqlserver://localhost:1433;database=family_finance;integratedSecurity=true;trustServerCertificate=true;encrypt=true"
#
# Most local installs are a named instance (SQL Server Express installs as
# "SQLEXPRESS" by default) — use this form instead if the default above
# can't connect. Find your instance name via SQL Server Configuration
# Manager, or `SELECT @@SERVERNAME` in SSMS:
# DATABASE_URL="sqlserver://localhost\\SQLEXPRESS;database=family_finance;integratedSecurity=true;trustServerCertificate=true;encrypt=true"
#
# Production — Azure SQL (SQL authentication, not Windows Auth):
# DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=<dbname>;user=<admin-user>;password=<password>;encrypt=true"

# ----------------------------------------------------------------------------
# AUTH
# ----------------------------------------------------------------------------
# Generate with: npx auth secret   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET=""
# Local dev:
NEXTAUTH_URL="http://localhost:3000"
# Production: set to your deployed URL, e.g. https://family-finance-app.vercel.app

# ----------------------------------------------------------------------------
# FIELD ENCRYPTION (used to encrypt TOTP MFA secrets at rest)
# ----------------------------------------------------------------------------
# Must be a 64-character hex string (32 bytes). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=""

# ----------------------------------------------------------------------------
# CRON (protects the recurring-transaction generation endpoint)
# ----------------------------------------------------------------------------
# Any random string. Set the same value as an environment variable on
# Vercel — Vercel Cron automatically sends it as a bearer token when
# calling scheduled routes defined in vercel.json.
CRON_SECRET=""

# ----------------------------------------------------------------------------
# TELEGRAM BOT (optional -- add transactions by messaging a bot)
# ----------------------------------------------------------------------------
# Create a bot by messaging @BotFather in Telegram (/newbot) and paste its token.
TELEGRAM_BOT_TOKEN=""
# Any long random string of letters, numbers, _ or - (16+ characters).
# Telegram sends it back with every webhook call; link codes derive from it.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=""

# ----------------------------------------------------------------------------
# TIME ZONE (optional)
# ----------------------------------------------------------------------------
# Which calendar day "today" is for transactions that arrive without a date
# (Telegram quick entries with no date). Defaults to US Eastern.
# Any IANA name, e.g. "America/Chicago" or "Asia/Kolkata".
APP_TIMEZONE=""
