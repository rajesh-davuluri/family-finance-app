// Family Finance App — Prisma schema
// Datasource: SQL Server (matches your existing local install / Azure SQL)
//
// NOTES CARRIED OVER FROM THE PREVIOUS BUILD (learned the hard way):
// - SQL Server has no native enum support in Prisma — every "enum-like"
//   field below is a plain String, validated in code via src/lib/enums.ts
// - SQL Server rejects a schema with more than one cascade path to the same
//   table — this applies to BOTH onDelete AND onUpdate independently (Prisma
//   defaults onUpdate to Cascade even when you only set onDelete, so both
//   must be set to NoAction explicitly wherever a second path exists, which
//   in this schema is everywhere, so every relation below sets both).
//   Cleanup that would otherwise have cascaded happens explicitly in
//   src/lib/cascadeDelete.ts instead.
// - createMany({ skipDuplicates: true }) is not supported — seed script
//   uses per-row upserts instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Household {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())

  // The emergency fund: money set aside for emergencies (typed in), and how
  // many months of essential spending it should cover. A bank account named
  // "Emergency..." with a balance takes the place of the typed-in amount.
  emergencyFundUsd     Decimal? @db.Decimal(12, 2)
  emergencyTargetMonths Int      @default(6)

  users       User[]
  instruments PaymentInstrument[]
  categories  TransactionCategory[]
  transactions Transaction[]
  recurring   RecurringTemplate[]
  debts       Debt[]
  budgets     Budget[]
  transfers   Transfer[]
  goals       SavingsGoal[]
  notifications Notification[]
  importBatches ImportBatch[]
  telegramLinks TelegramLink[]
  policies      InsurancePolicy[]
  itemCategoryRules  ItemCategoryRule[]
  investmentAccounts InvestmentAccount[]
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  passwordHash String
  role        String   @default("MEMBER") // ADMIN | MEMBER — see src/lib/enums.ts

  // TOTP MFA
  mfaEnabled        Boolean @default(false)
  mfaSecretEncrypted String? @db.NVarChar(Max)

  // Set on each successful sign-in: lastLoginAt is the current/most recent
  // one, previousLoginAt the one before it (what "your last login was"
  // shows, since lastLoginAt is normally the session you're in).
  lastLoginAt     DateTime?
  previousLoginAt DateTime?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt   DateTime @default(now())

  createdTransactions Transaction[] @relation("CreatedByUser")
  ownedDebts          Debt[]
  createdTransfers    Transfer[]
  notifications       Notification[]
  importBatches       ImportBatch[]
  telegramLinks       TelegramLink[]
}

model PaymentInstrument {
  id          String  @id @default(uuid())
  name        String
  type        String  // BANK_ACCOUNT | CREDIT_CARD | CASH | OTHER — see src/lib/enums.ts
  last4       String?
  currency    String  @default("USD")
  archived    Boolean @default(false)

  // Opening balance tracking: an amount plus the date it was true as of.
  // Current balance is computed as openingBalance + every income/expense
  // transaction logged against this instrument since openingBalanceDate --
  // never stored, so it can't drift. Both fields are optional together;
  // an instrument with neither set has no balance tracking (nothing to
  // compute from).
  openingBalance     Decimal?  @db.Decimal(12, 2)
  openingBalanceDate DateTime?

  // Credit cards only: the card's credit limit. Utilization is derived from
  // the current balance (negative = owed), never stored.
  creditLimit Decimal? @db.Decimal(12, 2)

  // Credit cards only: the day of the month the statement closes and the day
  // the payment is due (both printed on every statement). They set the
  // billing cycles on the Credit cards page.
  statementDay Int?
  dueDay       Int?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]
  transfersOut       Transfer[] @relation("TransferFrom")
  transfersIn        Transfer[] @relation("TransferTo")
  goals              SavingsGoal[]
  importBatches      ImportBatch[]
  details            AccountDetails?
  cardStatements     CardStatement[]

  createdAt   DateTime @default(now())
}

// Reference details for an account (bank, branch, IFSC/routing number,
// customer ID, where its login is kept). Kept apart from PaymentInstrument
// so they never ride along when transactions include their instrument.
// The full account number is stored encrypted (src/lib/encryption.ts) and
// only sent to the browser when someone clicks "Show". Passwords are not
// stored anywhere: loginNote says where they are kept (e.g. Bitwarden).
model AccountDetails {
  id String @id @default(uuid())

  instrumentId String            @unique
  instrument   PaymentInstrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  bankName               String?
  branch                 String?
  routingCode            String? // IFSC (India) or ABA routing number (US)
  accountNumberEncrypted String? @db.NVarChar(Max)
  accountNumberLast4     String?
  accountHolder          String?
  customerId             String?
  nominee                String?
  phone                  String?
  website                String?
  loginNote              String? @db.NVarChar(Max)
  notes                  String? @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A life (LIC endowment / money-back), term, health or other insurance
// policy: its numbers, people, contacts and premium schedule. Paying a
// premium records an ordinary Transaction and moves nextDueDate on (see
// src/lib/policies.ts); reminders go out before it is due
// (/api/cron/policy-reminders).
model InsurancePolicy {
  id String @id @default(uuid())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  kind          String  // LIFE | TERM | HEALTH | VEHICLE | OTHER -- see src/lib/policies.ts
  status        String  @default("ACTIVE") // ACTIVE | PAID_UP | MATURED | LAPSED | SURRENDERED
  insurer       String  // e.g. "LIC of India"
  planName      String? // e.g. "Jeevan Anand (915)"
  policyNumber  String?
  insuredPerson String?
  nominee       String?

  currency       String   @default("INR")
  sumAssured     Decimal? @db.Decimal(14, 2)
  maturityAmount Decimal? @db.Decimal(14, 2) // expected payout, if any (LIC endowment); null for term

  premiumAmount    Decimal?  @db.Decimal(12, 2)
  premiumFrequency String?   // MONTHLY | QUARTERLY | HALF_YEARLY | YEARLY | SINGLE
  nextDueDate      DateTime?
  premiumEndDate   DateTime? // last premium (LIC often stops premiums before the policy ends)
  startDate        DateTime?
  endDate          DateTime? // maturity date, or when term cover ends

  agentName  String?
  agentPhone String?
  helpline   String?
  website    String?
  loginNote  String? @db.NVarChar(Max)
  notes      String? @db.NVarChar(Max)
  // Anything else, as JSON [{ "label": "Rider", "value": "Accident benefit" }].
  extraFields String? @db.NVarChar(Max)

  payments  Transaction[]
  documents PolicyDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// A file kept with a policy: the bond, premium receipts, a nominee form.
// Stored in the database itself (a few MB at most) so nothing about a
// policy lives anywhere else.
model PolicyDocument {
  id          String @id @default(uuid())
  policyId    String
  policy      InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fileName    String @db.NVarChar(255)
  contentType String
  size        Int
  data        Bytes  @db.VarBinary(Max)

  uploadedById String

  createdAt DateTime @default(now())

  @@index([policyId])
}

model TransactionCategory {
  id        String  @id @default(uuid())
  name      String
  direction String  // INCOME | EXPENSE — see src/lib/enums.ts
  isDefault Boolean @default(false)
  // How its transactions count in totals: INCOME | REFUND | SPENDING | BILL |
  // DEBT_PAYMENT | SAVINGS | TRANSFER | LOAN -- see src/lib/categoryKind.ts.
  // Null means "not chosen yet": the kind is guessed from the name.
  kind      String?
  // Which group it rolls up into in reports: INCOME | HOUSING | UTILITIES |
  // TRANSPORTATION | FOOD | FAMILY | OBLIGATIONS | LIFESTYLE | SAVINGS |
  // TRANSFERS | OTHER -- see src/lib/categoryGroups.ts. Null: guessed.
  group     String? @map("categoryGroup")

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  transactions Transaction[]
  recurring    RecurringTemplate[]
  budgets      Budget[]
  itemRules    ItemCategoryRule[]

  createdAt DateTime @default(now())

  @@unique([householdId, name])
}

model Transaction {
  id       String   @id @default(uuid())
  amount   Decimal  @db.Decimal(12, 2)
  currency String   @default("USD")
  date     DateTime
  notes    String?  @db.NVarChar(Max)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  categoryId String
  category   TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  instrumentId String
  instrument   PaymentInstrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdById String
  createdBy   User   @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  recurringTemplateId String?
  recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // How it got into the app: MANUAL | IMPORTED | EMAIL | TELEGRAM | RECURRING
  // (see src/lib/lastActivity.ts). Null on rows created before this was
  // recorded -- those are inferred from importBatchId/recurringTemplateId.
  source String?

  // Set when the transaction came from a CSV import, null when entered by hand.
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Set when this is a premium paid on an insurance policy, so the policy
  // shows its own payment history.
  policyId String?
  policy   InsurancePolicy? @relation(fields: [policyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // A photo of the bill or receipt, taken with the phone.
  attachment TransactionAttachment?

  // Set on every part of one bill split across categories (a Costco trip:
  // groceries + clothing + household). The parts add up to the charge, and
  // duplicate checks treat them as that one charge.
  splitGroupId String?

  // For money sent to India: what arrived in rupees (and any fee).
  remittance RemittanceDetail?

  createdAt DateTime @default(now())

  @@index([householdId, date])
  @@index([splitGroupId])
}

model RecurringTemplate {
  id        String  @id @default(uuid())
  amount    Decimal @db.Decimal(12, 2)
  currency  String  @default("USD")
  notes     String? @db.NVarChar(Max)
  frequency String  // WEEKLY | MONTHLY | YEARLY — see src/lib/enums.ts
  nextRunAt DateTime
  active    Boolean @default(true)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  categoryId String
  category   TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  instrumentId String
  instrument   PaymentInstrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  generatedTransactions Transaction[]

  createdAt DateTime @default(now())
}

model Debt {
  id                   String    @id @default(uuid())
  name                 String    // e.g. "Chase Sapphire", "Toyota Loan"
  category             String    // CREDIT_CARD | AUTO_LOAN | PERSONAL_LOAN | MEDICAL | OTHER — see src/lib/enums.ts
  currency             String    @default("USD") // USD | INR | EUR | GBP — see src/lib/enums.ts. Payments are assumed to be in this same currency.
  conversionRateToUsd  Decimal?  @db.Decimal(10, 6) // e.g. 0.012 for INR->USD at the time this debt was taken out. Only meaningful when currency != USD. If left blank, comparisons fall back to the app's generic approximate rate (src/lib/fx.ts).
  originalPrincipal    Decimal   @db.Decimal(12, 2)
  interestRate         Decimal?  @db.Decimal(5, 2) // annual %, optional — omit if not modeling interest accrual
  startDate            DateTime
  installmentAmount    Decimal?  @db.Decimal(12, 2) // optional — only set for a fixed installment plan
  installmentFrequency String?   // WEEKLY | BIWEEKLY | MONTHLY — see src/lib/enums.ts
  status               String    @default("ACTIVE") // ACTIVE | PAID_OFF | CLOSED — see src/lib/enums.ts
  notes                String?   @db.NVarChar(Max)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Nullable: a joint/shared household debt has no single owner.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  payments DebtPayment[]

  createdAt DateTime @default(now())

  // Current balance is intentionally NOT a stored column — it's computed as
  // originalPrincipal - SUM(payments converted to this debt's currency) at
  // read time (see src/lib/debtCalculations.ts), so it can never drift out
  // of sync if a payment gets edited or deleted later.
}

model DebtPayment {
  id          String   @id @default(uuid())
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD") // USD | INR | EUR | GBP — independent of the debt's own currency; a debt can be paid down in either.
  paymentDate DateTime
  note        String?  @db.NVarChar(Max)

  debtId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
}

model Budget {
  id           String  @id @default(uuid())
  monthlyLimit Decimal @db.Decimal(12, 2) // tracked in approx. USD, same convention as other cross-currency totals in this app

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  categoryId String
  category   TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  // One standing monthly limit per category per household -- creating a
  // budget for a category that already has one updates it instead.
  @@unique([householdId, categoryId])
}

model Transfer {
  id       String   @id @default(uuid())
  amount   Decimal  @db.Decimal(12, 2)
  currency String   @default("USD") // both instruments are assumed to use this same currency -- no cross-currency conversion here
  date     DateTime
  notes    String?  @db.NVarChar(Max)

  // Moves money from one instrument to another WITHOUT counting as income
  // or an expense -- e.g. paying a credit card bill from a bank account.
  // The individual purchases were already logged as expenses against the
  // card; this only keeps each instrument's own running balance accurate.
  // Deliberately a separate model from Transaction, not a third
  // "direction" on it, so it can never accidentally leak into any
  // income/expense total, category breakdown, or budget calculation.
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  fromInstrumentId String
  fromInstrument   PaymentInstrument @relation("TransferFrom", fields: [fromInstrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  toInstrumentId String
  toInstrument   PaymentInstrument @relation("TransferTo", fields: [toInstrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
}

model SavingsGoal {
  id           String    @id @default(uuid())
  name         String    // e.g. "Emergency Fund", "Trip to India"
  targetAmount Decimal   @db.Decimal(12, 2)
  currency     String    @default("USD")
  targetDate   DateTime?

  // Progress is measured as the linked instrument's own current balance --
  // never stored here, so it can't drift. The common pattern is one
  // dedicated savings account per goal.
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  instrumentId String
  instrument   PaymentInstrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
}

model Notification {
  id      String  @id @default(uuid())
  message String  @db.NVarChar(Max) // plain-language summary, e.g. "Priya added a $45.00 Food expense"
  read    Boolean @default(false)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // The recipient -- one row per person notified. When Rajesh logs a
  // transaction, a Notification row is created for every OTHER household
  // member (not for Rajesh himself), so each person only sees things
  // someone else did.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  @@index([userId, read])
}

// One row per CSV import, so the Import page can show when the household
// last imported and which statement files have already been brought in.
model ImportBatch {
  id             String @id @default(uuid())
  fileName       String @db.NVarChar(255)
  currency       String
  rowsInFile     Int    // every data row the CSV contained
  importedCount  Int    // rows actually inserted as transactions
  duplicateCount Int    // rows flagged as already in the app (same date + amount)

  // Earliest and latest transaction dates in the file -- the statement period.
  periodStart DateTime?
  periodEnd   DateTime?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  instrumentId String
  instrument   PaymentInstrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  transactions Transaction[]

  createdAt DateTime @default(now())

  @@index([householdId, createdAt])
}

// A Telegram chat linked to a household member, so messages sent to the
// household's bot become that member's transactions.
model TelegramLink {
  id     String @id @default(uuid())
  chatId String @unique // Telegram's chat id (a number, kept as text)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
}

// A transaction read from a Telegram message, waiting for the person to tap
// "Add" (or change its card/category, or cancel). Deleted once handled;
// stale ones are cleared after a couple of days. Ids are plain strings --
// nothing references this table and it's never the source of truth.
model PendingTelegramTransaction {
  id           String   @id @default(uuid())
  chatId       String
  householdId  String
  userId       String
  amount       Decimal  @db.Decimal(12, 2)
  currency     String
  date         DateTime
  notes        String?  @db.NVarChar(Max)
  instrumentId String?
  categoryId   String?
  createdAt    DateTime @default(now())

  @@index([householdId])
}

// A brokerage, demat, retirement or crypto account holding investments
// (Zerodha, Groww, Robinhood, Fidelity 401(k)...). See src/lib/investments.ts.
model InvestmentAccount {
  id String @id @default(uuid())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name      String
  broker    String?
  country   String  // IN | US | OTHER
  currency  String  // what its holdings are priced in
  kind      String  // BROKERAGE | DEMAT | RETIREMENT | MUTUAL_FUND | CRYPTO | OTHER
  owner     String? // whose account it is
  loginNote String? @db.NVarChar(Max) // where the login is kept -- never a password
  notes     String? @db.NVarChar(Max)
  archived  Boolean @default(false)

  holdings Holding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// One stock, ETF, fund or coin in an account. Quantity, cost and gains are
// never stored: they come from its trades (first in, first out).
model Holding {
  id String @id @default(uuid())

  accountId String
  account   InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  symbol    String  // RELIANCE, AAPL, BTC, or an AMFI scheme code for an Indian mutual fund
  name      String?
  exchange  String  // NSE | BSE | US | AMFI | CRYPTO | OTHER
  assetType String  // STOCK | ETF | MUTUAL_FUND | CRYPTO | BOND | OTHER
  sector    String?
  currency  String

  // Latest price: fetched (LIVE) or typed in (MANUAL).
  lastPrice   Decimal?  @db.Decimal(18, 6)
  lastPriceAt DateTime?
  priceSource String?
  notes       String?   @db.NVarChar(Max)

  trades InvestmentTrade[]

  createdAt DateTime @default(now())

  @@index([accountId])
}

// A buy, a sale or a dividend on a holding.
model InvestmentTrade {
  id String @id @default(uuid())

  holdingId String
  holding   Holding @relation(fields: [holdingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  type     String   // BUY | SELL | DIVIDEND
  date     DateTime
  quantity Decimal? @db.Decimal(18, 6) // BUY/SELL
  price    Decimal? @db.Decimal(18, 6) // per unit, BUY/SELL
  fees     Decimal? @db.Decimal(12, 2) // brokerage, taxes and charges
  amount   Decimal? @db.Decimal(14, 2) // DIVIDEND: amount received
  notes    String?  @db.NVarChar(Max)

  createdAt DateTime @default(now())

  @@index([holdingId])
}

// Exchange rates fetched with prices (e.g. USDINR), shared by all households.
model MarketRate {
  pair      String   @id
  rate      Decimal  @db.Decimal(18, 6)
  updatedAt DateTime @updatedAt
}

// A credit card statement as printed: what it closed at, the minimum and when
// it's due. Typed in from the statement; the Credit cards page measures
// payments and new charges from its closing date.
model CardStatement {
  id           String            @id @default(uuid())
  instrumentId String
  instrument   PaymentInstrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  closingDate DateTime
  balance     Decimal   @db.Decimal(12, 2) // statement ("new") balance; negative = credit balance
  minimumDue  Decimal?  @db.Decimal(12, 2)
  dueDate     DateTime?
  notes       String?   @db.NVarChar(Max)

  createdAt DateTime @default(now())

  @@unique([instrumentId, closingDate])
}

// The photo of a bill or receipt behind a transaction (one per transaction).
// Stored downscaled as JPEG, a few hundred KB. Deleted with its transaction:
// this is the only path into the table, so a cascade is safe on SQL Server.
model TransactionAttachment {
  id            String      @id @default(uuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contentType   String
  size          Int
  data          Bytes       @db.VarBinary(Max)

  createdAt DateTime @default(now())
}

// What a receipt item is, as the household corrected it once ("KS ORG
// STRAWBERRY" -> Groceries, "MENS JOGGER" -> Clothing), so the next bill
// sorts it the same way. Removed with its category (the only cascade path).
model ItemCategoryRule {
  id          String              @id @default(uuid())
  householdId String
  household   Household           @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  itemKey     String              @db.NVarChar(100)
  categoryId  String
  category    TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  updatedAt DateTime @updatedAt

  @@unique([householdId, itemKey])
}

// Money sent to India (a Crobo / Remitly / Wise transfer from a US account):
// the rupees that arrived and any fee, typed in from the service's receipt,
// so the rate actually got can be compared with the market rate that day.
// Deleted with its transaction (the only path into the table).
model RemittanceDetail {
  id            String      @id @default(uuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inrReceived   Decimal     @db.Decimal(14, 2)
  feeUsd        Decimal?    @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt
}
